---
import Layout from "@layouts/Layout.astro";
import ProfileImage from "@components/ProfileImage.astro";
import SectionHeading from "@components/SectionHeading.astro";
import { LINKS, PERSON, SITE } from "@data/site";
import { PROFESSIONAL_PROFILE as profile } from "@data/professionalProfile";
import { absoluteUrl } from "@utils/urls";

const title = "Manish Sharma — Additive Manufacturing and Industrial AI";
const description = "Head of AI & R&D at Exafuse. Manufacturing project leadership, LMD/DED monitoring, WAAM collaboration, invited teaching and research at Ruhr University Bochum.";
const jsonLd = {
  "@context": "https://schema.org", "@type": "AboutPage",
  "@id": `${SITE.canonicalUrl}/about#page`, url: `${SITE.canonicalUrl}/about`,
  name: title, description, dateModified: profile.reviewed,
  mainEntity: { "@id": `${SITE.canonicalUrl}/identity#manish-sharma` }, image: absoluteUrl(PERSON.image)
};
---
<Layout title={title} description={description} canonical="/about" jsonLd={jsonLd}>
  <div class="professional-page">
    <section class="site-shell section-y grid items-center gap-10 lg:grid-cols-[1.35fr_.65fr]" aria-labelledby="profile-title">
      <div>
        <p class="metric-label">Manish Sharma · Industrial AI &amp; Decision Systems</p>
        <h1 id="profile-title" class="mt-5 text-4xl font-black leading-[1.07] tracking-tight text-white md:text-6xl">From process development<br /><span class="text-cyan-100">to manufacturing delivery.</span></h1>
        <p class="mt-6 text-xl font-bold text-white">{profile.role}</p>
        <p class="mt-4 max-w-2xl text-lg leading-8 text-slate-300">I lead additive-manufacturing projects across sourcing, CAD, processing, monitoring, quality checks and shipment. My work connects practical manufacturing, sensing and software with research and commercial decisions.</p>
        <p class="mt-4 text-base leading-7 text-slate-300">LMD/DED process development · Machine vision and robotics · WAAM collaboration</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="#selected-work" class="btn btn-primary">Explore selected work</a>
          <a href={LINKS.linkedin} class="btn btn-secondary" target="_blank" rel="noreferrer">LinkedIn</a>
          <a href="/contact" class="btn btn-secondary">Contact</a>
        </div>
        <nav class="mt-6 flex flex-wrap gap-x-6 gap-y-3 text-base text-cyan-100" aria-label="Professional profile sections">
          <a href="#collaborations">Teaching and advice</a><a href="#experience">Experience</a><a href="#education">Education</a>
        </nav>
      </div>
      <div class="profile-image-panel max-w-sm overflow-hidden rounded-lg border border-white/15 p-3 lg:max-w-none">
        <ProfileImage eager withCaption />
        <p class="px-2 pb-1 pt-4 text-base leading-7 text-slate-300">Engineering, research and delivery<br /><strong class="text-slate-100">Exafuse · Ruhr University Bochum</strong></p>
      </div>
    </section>

    <section class="band section-y">
      <div class="site-shell">
        <SectionHeading eyebrow="Project responsibility" title="The complete manufacturing chain" description="In a small manufacturing team, I work across the interfaces between engineering, operations and commercial delivery." />
        <ol class="mt-10 grid gap-7 sm:grid-cols-2 lg:grid-cols-4">
          {profile.workCycle.map((step) => (
            <li class="border-t border-cyan-100/25 pt-5"><span class="font-mono text-base text-cyan-200" aria-hidden="true">{step.number}</span><h3 class="mt-3 text-xl font-bold text-white">{step.title}</h3><p class="mt-3 text-base leading-7 text-slate-300">{step.text}</p></li>
          ))}
        </ol>
      </div>
    </section>

    <section id="selected-work" class="site-shell section-y">
      <SectionHeading eyebrow="Selected work" title="Manufacturing experience with technical depth" />
      <div class="mt-10">
        {profile.engineeringWork.map((project) => (
          <article class="grid gap-6 border-t border-white/15 py-8 md:grid-cols-[.85fr_1.2fr] md:gap-12">
            <div><p class="metric-label">{project.label}</p><h3 class="mt-3 text-2xl font-black text-white">{project.title}</h3><p class="mt-3 text-base text-cyan-100">{project.role}</p></div>
            <div><p class="text-base leading-8 text-slate-300">{project.text}</p><a href={project.href} class="mt-5 inline-block text-base font-bold text-cyan-100 underline underline-offset-4">{project.link}<span aria-hidden="true"> →</span></a></div>
          </article>
        ))}
      </div>
    </section>

    <section id="collaborations" class="band section-y">
      <div class="site-shell">
        <SectionHeading eyebrow="Knowledge exchange" title="Invited teaching and technical advice" />
        <div class="mt-10 grid gap-6 md:grid-cols-2">
          {profile.collaborations.map((item) => (
            <article class="ordered-card p-7"><p class="metric-label">{item.label}</p><h3 class="mt-3 text-2xl font-black text-white">{item.title}</h3><p class="mt-5 text-base leading-8 text-slate-300">{item.text}</p></article>
          ))}
        </div>
      </div>
    </section>

    <section id="experience" class="site-shell section-y">
      <SectionHeading eyebrow="Professional background" title="Experience" />
      <div class="mt-10">
        {profile.timeline.map((item) => (
          <article class="grid gap-5 border-t border-white/15 py-7 md:grid-cols-[.6fr_1.4fr] md:gap-10"><div><p class="metric-label">{item.period}</p><p class="mt-3 text-base font-bold text-cyan-100">{item.org}</p></div><div><h3 class="text-2xl font-bold text-white">{item.role}</h3><p class="mt-4 text-base leading-8 text-slate-300">{item.text}</p></div></article>
        ))}
      </div>
    </section>

    <section id="education" class="band section-y">
      <div class="site-shell">
        <SectionHeading eyebrow="Research and education" title="A foundation in photonics, control and AI" />
        <div class="mt-10 grid gap-8 lg:grid-cols-3">
          {profile.education.map((item) => (
            <article class="border-t border-cyan-100/25 pt-5"><h3 class="text-xl font-bold text-white">{item.title}</h3><p class="mt-3 text-base text-cyan-100">{item.org}</p><p class="mt-4 text-base leading-8 text-slate-300">{item.text}</p></article>
          ))}
        </div>
        <p class="mt-10 border-t border-white/15 pt-6 text-base leading-8 text-slate-300"><strong class="block text-white">Languages</strong>{profile.languages}</p>
      </div>
    </section>

    <section class="site-shell section-y grid gap-12 lg:grid-cols-[1.2fr_.8fr]">
      <div>
        <SectionHeading eyebrow="Publication and speaking" title="Sharing practical engineering knowledge" />
        <ul class="mt-8 grid gap-5 text-base leading-8 text-slate-300">
          <li><a href="/evidence" class="text-cyan-100 underline underline-offset-4">Laser metal deposition of lattice structures by columnar built-up</a> · CIRP LANE 2018.</li>
          {profile.talks.map((talk) => <li>{talk}</li>)}
          <li>Material Horizon Prize, CIRP LANE 2018; DAAD Graduation Scholarship, 2019; C++ Nanodegree, 2022.</li>
        </ul>
      </div>
      <div class="border-l-2 border-cyan-200/50 pl-7">
        <h2 class="text-3xl font-black leading-tight text-white">Discuss an engineering challenge</h2>
        <p class="my-6 text-base leading-8 text-slate-300">Manufacturing digitalization, process monitoring, research collaboration or a guest lecture.</p>
        <a href="/contact" class="btn btn-primary">Start a conversation</a>
        <p class="mt-6 text-sm text-slate-400">Profile updated September 2026</p>
      </div>
    </section>
  </div>
</Layout>

<style>
  .professional-page section[id] { scroll-margin-top: 7rem; }
  .professional-page nav a { text-decoration: underline; text-underline-offset: .25em; }
  .professional-page :is(h1, h2, h3, p, li) { overflow-wrap: break-word; }
</style>
