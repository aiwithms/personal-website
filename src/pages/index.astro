---
import CTAButton from "@components/CTAButton.astro";
import DecisionBriefCard from "@components/DecisionBriefCard";
import ExafuseProofMedia from "@components/ExafuseProofMedia.astro";
import Layout from "@layouts/Layout.astro";
import SectionHeading from "@components/SectionHeading.astro";
import { resolveExafuseLink } from "../config/externalLinks";
import { EXAFUSE_PUBLIC_PROOF } from "@data/exafusePublicProof";
import { WORN_SHAFT_BRIEF } from "../lib/decisionBrief";
import { LAB_NOTES, LINKS, PERSON, SAME_AS, SITE } from "@data/site";
import { PROFESSIONAL_PROFILE as profile } from "@data/professionalProfile";

const title = "Manish Sharma — Laser Manufacturing & Industrial Systems";
const description =
  "Head of AI & R&D at Exafuse. Hands-on DED/LMD engineering, lasers and photonics, sensing, control, manufacturing systems and technical project leadership.";
const exafuseRfqLink = resolveExafuseLink("rfq");
const flagshipProof = EXAFUSE_PUBLIC_PROOF.find((proof) => proof.id === "cs15-duisburg-bridge");
const supportingProof = EXAFUSE_PUBLIC_PROOF.find((proof) => proof.id === "cs05-valve-seat-ring");

const personJsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": `${SITE.canonicalUrl}/identity#manish-sharma`,
  name: PERSON.name,
  url: `${SITE.canonicalUrl}/identity`,
  sameAs: SAME_AS,
  jobTitle: "Head of AI & R&D",
  worksFor: {
    "@type": "Organization",
    name: "Exafuse / ThinkIng – Additive Technology GmbH",
    url: LINKS.exafuse
  },
  knowsAbout: [
    "Lasers and Photonics",
    "Optical Sensing and Calibration",
    "Laser-based Manufacturing",
    "Technical Project and R&D Leadership",
    "Manufacturing Systems and Traceability",
    "Industrial AI",
    "Industrial Decision Systems",
    "Decision Support",
    "Evidence-aware AI",
    "Engineering Decision-making",
    "Industrial Automation",
    "Machine Vision",
    "Robotics",
    "Laser Metal Deposition",
    "Directed Energy Deposition",
    "Process Monitoring",
    "RFQ Intelligence",
    "Industrial Repair",
    "Repair and Cladding",
    "Inspection Evidence"
  ]
};

const websiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${SITE.canonicalUrl}/#website`,
  name: SITE.preferredSiteName,
  alternateName: SITE.alternateSiteName,
  url: SITE.canonicalUrl,
  description,
  inLanguage: "en",
  author: { "@id": `${SITE.canonicalUrl}/identity#manish-sharma` }
};

const profilePageJsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "@id": `${SITE.canonicalUrl}/#profile-page`,
  url: SITE.canonicalUrl,
  name: title,
  mainEntity: { "@id": `${SITE.canonicalUrl}/identity#manish-sharma` }
};

const flagshipAssets = [
  {
    title: "LMD Decision Cockpit",
    href: "/tools#lmd-decision-cockpit",
    problem: "A decision starts before every fact is known.",
    helps: "Turn facts, gaps, risk, and evidence needs into a next action.",
    cannot: "Replace engineering approval or final feasibility review.",
    cta: "Run the Cockpit"
  },
  {
    title: "Camera Is Not a Certificate",
    href: "/lab-notes/camera-is-not-a-certificate",
    problem: "A process image can look convincing before it becomes sufficient evidence.",
    helps: "Separate monitoring signals from an inspection-backed quality claim.",
    cannot: "Turn a signal into a release decision.",
    cta: "Read the note"
  }
];

const homepageProcessSteps = [
  {
    index: "01",
    label: "Sense",
    description: "Capture the process signal and its operating context.",
    tone: "success"
  },
  {
    index: "02",
    label: "Model",
    description: "Make assumptions visible.",
    tone: "signal"
  },
  {
    index: "03",
    label: "Decide",
    description: "Plan the evidence needed.",
    tone: "active"
  },
  {
    index: "04",
    label: "Verify",
    description: "Use inspection evidence.",
    tone: "risk"
  }
];

---

<Layout
  title={title}
  description={description}
  canonical="/"
  jsonLd={[websiteJsonLd, personJsonLd, profilePageJsonLd]}
  alternates={[
    { lang: "en", href: "/" },
    { lang: "de", href: "/de" },
    { lang: "x-default", href: "/" }
  ]}
>
  <section class="home-premium-hero home-chapter home-chapter--position" data-page-chapter="position">
    <div class="site-shell home-hero-grid">
      <div class="home-hero__copy">
        <p class="home-hero__context">Head of AI &amp; R&amp;D at Exafuse · External PhD Researcher at Ruhr University Bochum</p>
        <h1 class="home-hero__title">
          <span class="home-hero__title-main">Laser-based manufacturing</span>
          <span class="home-hero__title-evidence"><em>and industrial systems.</em></span>
        </h1>
        <p class="home-hero__intro">
          I'm a hands-on engineer with more than six years in Directed Energy Deposition / Laser Metal Deposition (DED/LMD) and a background in lasers and photonics. I work from deposition strategy and robotics to optical/process monitoring, control, documentation and quality—taking processes from “it works once” to repeatable, scalable production.
        </p>
        <p class="home-hero__secondary">My work spans DED process development, sensing, machine integration, manufacturing data and R&amp;D project leadership. Applied AI, numerical modelling and automation are engineering tools I use to make physical processes more robust, measurable and scalable.</p>
        <div class="home-hero__actions">
          <CTAButton href="/public-work" variant="primary">View selected work</CTAButton>
          <CTAButton href="/thesis" variant="secondary">Explore research and method</CTAButton>
        </div>
      </div>

      <div class="home-hero__evidence-grid">
        <section class="home-hero__evidence-note" aria-labelledby="home-hero-process-title">
          <p class="home-hero__panel-label" id="home-hero-process-title">Process &amp; material</p>
          <dl class="home-hero__dossier">
            <div>
              <dt>Domain</dt>
              <dd>Laser metal deposition</dd>
            </div>
            <div>
              <dt>Engineering</dt>
              <dd>Deposition, sensing and control</dd>
            </div>
            <div>
              <dt>Foundation</dt>
              <dd>Lasers and photonics</dd>
            </div>
          </dl>
          <a class="home-hero__micro-link" href="/domains/lmd-ded">Explore DED/LMD <span aria-hidden="true">→</span></a>
        </section>

        <figure class="home-hero__melt-pool" data-audit-context="LMD melt-pool photograph">
          <picture>
            <source media="(max-width: 639px)" type="image/webp" srcset="/images/melt-pool-hero-1024.webp" />
            <source type="image/webp" srcset="/images/melt-pool-hero.webp" />
            <source media="(max-width: 639px)" srcset="/images/melt-pool-hero-1024.jpg" />
            <img
              src="/images/melt-pool-hero.jpg"
              alt="Melt pool created during the laser metal deposition process."
              width="1586"
              height="992"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          </picture>
          <figcaption>
            <span>Melt pool</span>
            <span>Created in the laser metal deposition process.</span>
          </figcaption>
        </figure>

        <section class="home-hero__evidence-note home-hero__evidence-note--action" aria-labelledby="home-hero-action-title">
          <p class="home-hero__panel-label" id="home-hero-action-title">Engineering in use</p>
          <a href="/lab-notes/lmd-control-system/">From sensors to machine control <span aria-hidden="true">→</span></a>
          <p>{profile.deployment}</p>
          <span class="home-hero__action-meta">Personal engineering account</span>
        </section>
      </div>

      <ul class="home-hero__principles" aria-label="Decision system principles">
        <li>
          <strong>Evidence first</strong>
          <span>Models propose. Evidence matters.</span>
        </li>
        <li>
          <strong>Human review</strong>
          <span>Critical decisions require human review.</span>
        </li>
        <li>
          <strong>Traceability</strong>
          <span>Recommendation context stays visible.</span>
        </li>
        <li>
          <strong>Provenance</strong>
          <span>Sources stay attached to claims.</span>
        </li>
        <li>
          <strong>Trust boundary</strong>
          <span>Decision-support is not approval.</span>
        </li>
      </ul>
    </div>
  </section>

  <section class="site-shell section-y home-engineering-section" data-page-chapter="expertise" aria-labelledby="home-expertise-title">
    <p class="metric-label">Areas of work</p>
    <h2 id="home-expertise-title">Process depth. Connected systems. Technical responsibility.</h2>
    <p class="home-engineering-section__intro">Deep DED/LMD experience is the strongest proof of how I work. The same work connects lasers and photonics, practical sensing, industrial systems and project delivery.</p>
    <div class="home-expertise-grid">
      {profile.expertise.map((area) => (
        <article><h3>{area.title}</h3><p>{area.text}</p></article>
      ))}
    </div>
    <p class="home-engineering-section__leadership">My foundation is an M.Sc. in Lasers and Photonics at Ruhr University Bochum, with the Faculty Prize for best student, and a B.Tech. in Electrical Engineering.</p>
  </section>

  <section class="site-shell section-y home-engineering-section" data-page-chapter="selected-work" aria-labelledby="home-selected-work-title">
    <p class="metric-label">Selected work</p>
    <h2 id="home-selected-work-title">From process development to systems people use.</h2>
    <div class="home-selected-work-grid">
      {profile.selectedCases.map((project) => (
        <article>
          <h3>{project.title}</h3>
          <p>{project.responsibility}</p>
          <p class="home-selected-work__result">{project.result}</p>
          <a href={project.href}>{project.link}<span aria-hidden="true"> →</span></a>
        </article>
      ))}
    </div>
    <a class="home-engineering-section__all-link" href="/public-work">Read the engineering context and my contribution <span aria-hidden="true">→</span></a>
  </section>

  {flagshipProof && (
    <section class="home-proof-strip home-chapter home-chapter--proof" data-page-chapter="public-proof" aria-labelledby="home-proof-title">
      <div class="site-shell home-proof-strip__grid">
        <div class="home-proof-strip__lead">
          <p class="metric-label">DED/LMD in practice</p>
          <h2 id="home-proof-title">Monitoring and control for Duisburg bridge components.</h2>
          <p>{profile.selectedDelivery}</p>
          <a href={`/public-work/exafuse/${flagshipProof.slug}`} class="home-proof-strip__story-link">Read the project and my role <span aria-hidden="true">→</span></a>
        </div>
        <div class="home-proof-strip__case">
          <div class="home-proof-strip__case-media">
            <ExafuseProofMedia proof={flagshipProof} sizes="(max-width: 767px) calc(100vw - 2rem), 62vw" />
          </div>
          <div class="home-proof-strip__case-evidence">
            <div class="home-proof-strip__facts">
              {flagshipProof.publicMetrics.slice(0, 3).map((metric) => (
                <p data-exafuse-proof-metric={metric.sourcePath}><strong>{metric.value}{metric.unit ? ` ${metric.unit}` : ""}</strong><span>{metric.label}</span></p>
              ))}
            </div>
            <p class="home-proof-strip__limit">Project scale from Exafuse's published record. My contribution is described separately; these figures are not personal output or engineering approval.</p>
          </div>
        </div>
      </div>
    </section>
  )}

  <section class="home-opening-flow home-method-chapter home-chapter home-chapter--method" data-page-chapter="method" data-operating-loop="homepage" aria-labelledby="home-opening-flow-title">
    <div class="home-opening-flow__atmosphere" aria-hidden="true"></div>
    <div class="site-shell home-opening-flow__inner">
      <div class="home-opening-flow__process">
        <div class="home-opening-flow__process-intro">
          <p class="metric-label">Research and method</p>
          <h2 id="home-opening-flow-title">Sense → Model → Decide → Verify</h2>
          <p>To me, a prediction is only one part of the job. The next action, the missing context, and the verification path have to be clear too.</p>
        </div>

        <ol class="home-opening-flow__steps" aria-label="Sense, model, decide, verify process">
          {homepageProcessSteps.map((step) => (
            <li class:list={["home-opening-flow__step", `home-opening-flow__step--${step.tone}`]}>
              <span class="home-opening-flow__step-index">{step.index}</span>
              <strong>{step.label}</strong>
              <span>{step.description}</span>
            </li>
          ))}
        </ol>

        <aside class="home-opening-flow__boundary" aria-label="Decision-support boundary">
          Preliminary decision-support only. Final feasibility depends on base material, geometry, service conditions, inspection requirements, and expert review.
        </aside>

        <div class="home-opening-flow__direction">
          <h3>The broader question behind the current work</h3>
          <p>
            I am studying how this approach can help with decisions based on incomplete physical signals, operational risk, and human responsibility. That is a research direction, not a cross-industry deployment claim.
          </p>
          <ul aria-label="Decision classes under study">
            <li>Incomplete physical signals</li>
            <li>High cost of false confidence</li>
            <li>Model output connected to inspection</li>
            <li>Operational context changes the recommendation</li>
            <li>Human responsibility remains explicit</li>
            <li>Traceability matters after the model runs</li>
          </ul>
        </div>

        <nav class="home-opening-flow__links" aria-label="Method and current work">
          <a href="/thesis">Read the method <span aria-hidden="true">→</span></a>
          <a href="/domains/lmd-ded">See current LMD/DED work <span aria-hidden="true">→</span></a>
        </nav>
      </div>

    </div>
  </section>

  <section id="lmd-decision-cockpit" class="home-opening-flow home-cockpit-chapter home-chapter home-chapter--product" data-page-chapter="product" aria-labelledby="home-cockpit-title">
    <div class="home-opening-flow__atmosphere" aria-hidden="true"></div>
    <div class="site-shell home-opening-flow__inner">
      <div class="home-cockpit-chapter__intro">
        <p class="metric-label">Research tools · Working decision product</p>
        <h2 id="home-cockpit-title">See what the decision needs before asking for confidence.</h2>
        <p>The Cockpit keeps the decision signal, critical gaps, risk, evidence needed, and next action visible. Confidence is not approval.</p>
      </div>
      <section class="home-opening-flow__cockpit" aria-label="LMD Decision Cockpit preview">
        <div class="home-cockpit-preview">
          <div class="home-cockpit-preview__heading">
            <p class="metric-label">Working example</p>
            <h3>Show the signal, the gaps, and the next action.</h3>
          </div>
          <div class="home-cockpit-preview__brief">
            <p class="home-cockpit-preview__scenario">Example scenario: worn steel shaft near bearing seat.</p>
            <DecisionBriefCard
              client:load
              brief={WORN_SHAFT_BRIEF}
              eyebrow="Evidence-aware by design"
              title="LMD Decision Brief v1.0"
              matchingToolHref="/tools/#lmd-decision-cockpit"
              compact
            />
          </div>
        </div>
      </section>
      <div class="home-cockpit-chapter__actions">
        <CTAButton href="/tools/#lmd-decision-cockpit" variant="primary">Run the Decision Cockpit</CTAButton>
        <CTAButton href="/brief-standard" variant="secondary">Read the Decision Brief standard</CTAButton>
      </div>
    </div>
  </section>

  <div class="home-continuation">
    <div class="home-chapter home-chapter--knowledge" data-page-chapter="knowledge">
    <section class="home-section home-section--assets" aria-label="Flagship decision assets">
      <div class="site-shell home-section__inner">
        <SectionHeading
          eyebrow="Research platform"
          title="Methods, tools and technical notes"
          description="My industrial-AI research explores how physical signals, models and evidence support engineering decisions. Public company cases provide context; the tools make assumptions and limits visible."
        />
        <div class="home-assets-grid home-assets-grid--proof-led">
          {supportingProof && (
            <article class="home-asset-card home-asset-card--lead">
              <ExafuseProofMedia proof={supportingProof} sizes="(max-width: 767px) calc(100vw - 2rem), 52vw" />
              <span>
                <p class="metric-label">Supporting industrial proof</p>
                <h3><a href={`/public-work/exafuse/${supportingProof.slug}`}>{supportingProof.shortTitle}</a></h3>
                <p>{supportingProof.mainDecisionLesson}</p>
              </span>
              <a href={`/public-work/exafuse/${supportingProof.slug}`} class="home-asset-card__action">Read the proof story <span aria-hidden="true">→</span></a>
            </article>
          )}
          {flagshipAssets.map((asset) => (
            <a href={asset.href} class="home-asset-card">
              <span>
                <h3>{asset.title}</h3>
                <dl>
                  <div>
                    <dt>Problem</dt>
                    <dd>{asset.problem}</dd>
                  </div>
                  <div>
                    <dt>Helps decide</dt>
                    <dd>{asset.helps}</dd>
                  </div>
                  <div>
                    <dt>Cannot prove</dt>
                    <dd>{asset.cannot}</dd>
                  </div>
                </dl>
              </span>
              <span class="home-asset-card__action" aria-hidden="true">{asset.cta} <span>→</span></span>
            </a>
          ))}
        </div>
        <a class="home-section__all-link" href="/frameworks">Explore all frameworks <span aria-hidden="true">→</span></a>
      </div>
    </section>

    <section class="home-section home-section--notes" aria-label="Selected authored note">
      <div class="site-shell home-section__inner">
        <SectionHeading
          eyebrow="Authored note"
          title="One idea behind the broader platform"
          description="A first-person note on keeping model output, context, action, and verification connected."
        />
        <div class="home-notes-grid home-notes-grid--single">
        {LAB_NOTES.slice(0, 1).map((note) => (
          <a href={note.href} class="home-note-card">
            <span>
              <time datetime={note.date}>{note.date}</time>
              <h3>{note.title}</h3>
              <p>{note.description}</p>
            </span>
            <span class="home-note-card__action" aria-hidden="true">Read note <span>→</span></span>
          </a>
        ))}
        </div>
      </div>
    </section>
    </div>

    <div class="home-chapter home-chapter--boundary" data-page-chapter="boundary">
    <section class="home-section home-section--routes" aria-label="Public and commercial routes">
      <div class="site-shell home-section__inner home-route-grid">
      <div class="home-route-card home-route-card--public">
        <p>Personal platform</p>
        <h2>Explore the method, current work, and research questions.</h2>
        <p>{SITE.shortDescription}</p>
        <div class="home-route-card__actions">
          <CTAButton href="/public-work" variant="primary">Explore my work</CTAButton>
          <CTAButton href="/about" variant="secondary">About Manish</CTAButton>
        </div>
      </div>
      <div class="home-route-card home-route-card--commercial">
        <p>Commercial boundary</p>
        <h2>For commercial LMD/DED services and RFQs, use Exafuse.</h2>
        <p>
          My current applied LMD/DED work is carried out through Exafuse. This site shares public methods and notes; company services, case studies, and engineering review belong there.
        </p>
        <div class="home-route-card__actions">
          <CTAButton href={exafuseRfqLink.href} variant="laser" external>{exafuseRfqLink.label}</CTAButton>
          <CTAButton href="/contact" variant="secondary">Contact routes</CTAButton>
        </div>
      </div>
      </div>
    </section>
    <section class="home-section home-section--mission" aria-labelledby="home-mission-title">
      <div class="site-shell home-mission">
        <div>
          <p class="metric-label">Engineering approach</p>
          <h2 id="home-mission-title">Build the workflow around the physical process.</h2>
        </div>
        <div>
          <p>The process, measurement, machine interfaces and operator records need to work as one system. I connect these parts so a useful result on the shop floor can become a repeatable way of working.</p>
          <a href="/about">More about my work <span aria-hidden="true">→</span></a>
          <p class="home-mission__context">Applied AI and automation have a place in that workflow, alongside calibration, engineering judgement and physical verification.</p>
        </div>
      </div>
    </section>
    <section class="home-contact-chapter" aria-labelledby="home-contact-title">
      <div class="site-shell home-contact-chapter__inner">
        <div>
          <p>Professional contact</p>
          <h2 id="home-contact-title">Let's talk engineering.</h2>
        </div>
        <div>
          <p>Technical projects, R&amp;D, laser-based manufacturing, photonics and sensing, or industrial systems.</p>
          <a href="/contact">Contact Manish <span aria-hidden="true">→</span></a>
        </div>
        <span>Manish Sharma / Laser-based manufacturing and industrial systems</span>
      </div>
    </section>
    </div>
    </div>
</Layout>
