  .control-story__opening { margin-block: 2rem; }
  .control-story p + p { margin-top: 1rem; }
  .control-story__image-note { max-width: 98ch; border-left: 2px solid var(--accent-2); padding: .25rem 0 .25rem 1.1rem; color: var(--muted); font-size: .87rem; line-height: 1.75; }
  .control-story__image-note strong { color: var(--text-soft); }
