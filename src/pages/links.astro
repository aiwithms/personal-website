---
import Layout from "@layouts/Layout.astro";
import SectionHeading from "@components/SectionHeading.astro";
import SourceLinks from "@components/SourceLinks.astro";
import { PROFILE_LINKS } from "@data/profiles";

const title = "Profiles and Links - Manish Sharma Lab";
const description = "Manish Sharma's active website, LinkedIn and Exafuse links, with work-in-progress profile destinations.";
---

<Layout title={title} description={description} canonical="/links">
  <div class="info-page info-page--compact">
  <section class="site-shell info-page__masthead py-16 md:py-20">
    <SectionHeading as="h1" eyebrow="Links" title="Profiles and repositories" description="LinkedIn and Exafuse are active. Other destinations are work in progress." />
    <div class="mt-10">
      <SourceLinks links={PROFILE_LINKS} />
    </div>
  </section>
  </div>
</Layout>
