---
import Layout from "@layouts/Layout.astro";
import ExafuseProofMedia from "@components/ExafuseProofMedia.astro";
import PageHeroVisual from "@components/PageHeroVisual.astro";
import SectionHeading from "@components/SectionHeading.astro";
import SourceLinks from "@components/SourceLinks.astro";
import { PROFILE_LINKS } from "@data/profiles";
import { EXAFUSE_PUBLIC_PROOF } from "@data/exafusePublicProof";
import { FRAMEWORKS, LINKS, PERSON, SITE } from "@data/site";
import { EXAFUSE_SOURCE_LINKS } from "@data/exafuse";
import { PROFESSIONAL_PROFILE as profile } from "@data/professionalProfile";
import { resolveExafuseLink } from "../config/externalLinks";

const breitbahnLink = resolveExafuseLink("breitbahnDedGuide");

const title = "Selected work";
const description =
  "Manish Sharma's engineering work: DED/LMD manufacturing, monitoring and control, optical height sensing, MES/ERP adoption and technical R&D project leadership.";

const currentContext = [
  ["Technical foundation", "Lasers, photonics and electrical engineering"],
  ["Deepest process experience", "More than six years in DED/LMD"],
  ["Responsibility", "Hands-on engineering and R&D leadership"],
  ["Evidence scope", "Personal accounts and attributed public sources"]
];

const establishedWork = [
  ["Process development", "DED/LMD deposition strategy, process parameters, documentation and quality workflows."],
  ["Optical monitoring", "Cameras, illumination, calibration and image-based measurement in a laser-processing environment."],
  ["Robotic workflows", "Robotic DED/LMD systems, toolpath development and machine integration."],
  ["Manufacturing data", "Print-ID traceability, in-house MES/ERP, operator procedures and process records."],
  ["LPBF preparation", "Practical build preparation and troubleshooting, distinct from the six-plus years of DED/LMD experience."],
  ["Industrial repair", "Repairability screening, RFQ structure, cladding, machining allowance, and inspection planning."],
  ["RFQ intelligence", "Schemas, prompts, decision rules, and missing-information checks for LMD requests."]
];

const sections = [
  {
    title: "Public frameworks",
    status: "Public framework",
    links: FRAMEWORKS.slice(0, 6).map((framework) => ({
      label: framework.title,
      href: framework.href,
      description: framework.idea
    }))
  },
  {
    title: "Public tools",
    status: "Working tool",
    links: [
      { label: "Tools", href: "/tools", description: "LMD vs SLM advisor, repairability quick check, and RFQ converter." },
      { label: "Laser Metal Deposition Decision Map", href: "/decision-map", description: "Route repair, cladding, large-part AM, SLM alternatives, machining, welding, and replacement screening." },
      { label: "LMD RFQ Toolkit", href: "/agent-pack", description: "Schemas, prompts, rules, and checklists." },
      { label: "RFQ Schema", href: "/agent-pack/lmd-rfq-schema.json" }
    ]
  },
  {
    title: "Research and evidence maps",
    status: "Public evidence",
    links: [
      { label: "Evidence Base", href: "/evidence" },
      { label: "Core LMD-AI Sources", href: "/research/core-lmd-ai-sources" },
      { label: "500-record LMD/DED literature map", href: "/research/lmd-literature-scan.json" },
      { label: "Industrial Evidence Map", href: "/industrial-proof" }
    ]
  },
  {
    title: "Technical artifacts",
    status: "Public artifact",
    links: [
      { label: "llms.txt", href: "/llms.txt" },
      { label: "llms-full.txt", href: "/llms-full.txt" },
      { label: "identity.md", href: "/identity.md" }
    ]
  }
];

const proofDecisionPatterns: Record<string, { label: string; href: string }> = {
  "cs15-duisburg-bridge": { label: "Start a brief from this pattern", href: "/tools/#preset=monitoring-anomaly" },
  "cs10-nobufil-extrusion-screw": { label: "Start a brief from this pattern", href: "/tools/#preset=rfq" },
  "cs05-valve-seat-ring": { label: "Start a brief from this pattern", href: "/tools/#preset=surface-cladding" },
  "cs13-zipp-drill": { label: "Start a brief from this pattern", href: "/tools/#preset=surface-cladding" }
};

const proofDecisionPatternText: Record<string, string> = {
  "cs15-duisburg-bridge": "Large-scale LMD requires evidence planning, monitoring context, and an inspection boundary.",
  "cs10-nobufil-extrusion-screw": "Repair/RFQ quality depends on complete facts, downtime context, and service context.",
  "cs05-valve-seat-ring": "Surface function needs material, heat, finishing, inspection, and acceptance context.",
  "cs13-zipp-drill": "Build-and-coat routes need geometry, surface function, material, finishing, and validation."
};

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": `${SITE.canonicalUrl}/public-work#page`,
  url: `${SITE.canonicalUrl}/public-work`,
  name: title,
  description,
  mainEntity: { "@id": `${SITE.canonicalUrl}/identity#manish-sharma`, name: PERSON.name }
};
---

<Layout title={`${title} - Manish Sharma Lab`} description={description} canonical="/public-work" jsonLd={jsonLd}>
  <div class="public-work-index">
  <div class="public-work-chapter public-work-chapter--identity" data-page-chapter="identity">
  <section class="site-shell section-y public-work-index__masthead">
    <div class="public-work-index__masthead-grid grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(24rem,0.62fr)] lg:items-center">
      <div>
        <p class="metric-label">Engineering, R&amp;D and manufacturing delivery</p>
        <h1 class="mt-4 text-5xl font-black leading-tight text-white md:text-6xl">{title}</h1>
        <p class="mt-6 max-w-3xl text-lg leading-8 text-slate-300">
          My strongest technical proof is more than six years in DED/LMD: developing the process, measuring what happens and connecting the machine to a usable manufacturing workflow. These examples show my responsibility across sensing, control, optical measurement and project delivery.
        </p>
        <div class="public-work-index__masthead-actions mt-8 flex flex-wrap gap-3">
          <a href="#professional-work-title" class="btn btn-primary">Explore the engineering cases</a>
          <a href="/thesis" class="btn btn-secondary">Read the method</a>
          <a href="/about" class="btn btn-secondary">About Manish</a>
        </div>
      </div>
      <PageHeroVisual variant="profile" class="hidden lg:block" />
    </div>
  </section>

  <section class="band public-work-index__context-band">
    <div class="site-shell grid gap-3 py-6 md:grid-cols-4">
      {currentContext.map(([label, value]) => (
        <div class="ordered-card public-work-index__context-card p-4">
          <p class="metric-label">{label}</p>
          <p class="mt-2 text-sm font-bold leading-6 text-white">{value}</p>
        </div>
      ))}
    </div>
  </section>
  </div>

  <div class="public-work-chapter public-work-chapter--proof" data-page-chapter="proof">
  <section class="band section-y" aria-labelledby="professional-work-title">
    <div class="site-shell">
      <p class="metric-label">Selected engineering cases</p>
      <h2 id="professional-work-title" class="mt-3 text-3xl font-black text-white">What I built, integrated and coordinated.</h2>
      <p class="mt-5 max-w-4xl text-lg leading-8 text-slate-300">These are my professional accounts of the work. The detailed pages retain the measurement limits, demonstration labels and company attribution that define what each example supports.</p>
      <div class="mt-8 grid gap-6 md:grid-cols-2">
        {profile.selectedCases.map((project) => (
          <article id={project.id} class="ordered-card p-6">
            <h3 class="text-2xl font-bold text-white">{project.title}</h3>
            <p class="mt-4 text-base leading-7 text-slate-300">{project.context}</p>
            <p class="mt-4 text-base leading-7 text-slate-200"><strong>My responsibility.</strong> {project.responsibility}</p>
            <p class="mt-4 text-base leading-7 text-slate-300">{project.delivery}</p>
            <p class="mt-4 text-base leading-7 text-slate-300"><strong class="text-white">Result and scope.</strong> {project.result}</p>
            <a href={project.href} class="mt-5 inline-block font-bold text-cyan-100 underline underline-offset-4">{project.link}</a>
          </article>
        ))}
      </div>
      <div id="breitbahnded" class="mt-10 border-t border-white/15 pt-7">
        <p class="metric-label">Technical project &amp; R&amp;D leadership</p>
        <h3 class="mt-3 text-2xl font-bold text-white">Exafuse's contribution to BreitbahnDED</h3>
        <p class="mt-4 max-w-4xl text-base leading-7 text-slate-300">I led Exafuse's contribution, including technical coordination, milestones, costs and reporting, and helped develop and write the proposal. My responsibility connected manufacturing requirements, monitoring and software with university research; it does not represent leadership of the whole consortium.</p>
        <p class="mt-4 max-w-4xl text-base leading-7 text-slate-300">Alongside project delivery, I have managed five employees with hiring responsibility.</p>
        <a href={breitbahnLink.href} class="mt-5 inline-block font-bold text-cyan-100 underline underline-offset-4">Read the Exafuse project article</a>
      </div>
      <div class="mt-10 grid gap-6 md:grid-cols-2">
        <article class="ordered-card p-6"><h3 class="text-xl font-bold text-white">Indian Space Research Organisation (ISRO)</h3><p class="mt-4 text-base leading-7 text-slate-300">Personally invited guest lectures, additive-manufacturing advice and contributions to WAAM machine development for rocket-nozzle manufacturing.</p></article>
        <article class="ordered-card p-6"><h3 class="text-xl font-bold text-white">Industry knowledge exchange</h3><p class="mt-4 text-base leading-7 text-slate-300">Additive-manufacturing advice to Tata Steel and Bharat Heavy Electricals Limited (BHEL), Haridwar, and technical talks at Outokumpu and Data Science Ruhrgebiet.</p></article>
      </div>
      <div id="website-development" class="mt-8 border-t border-white/15 pt-7">
        <h3 class="text-xl font-bold text-white">Exafuse website development</h3>
        <p class="mt-4 max-w-4xl text-base leading-7 text-slate-300">{profile.websiteDelivery}</p>
        <a href={LINKS.exafuse} class="mt-5 inline-block font-bold text-cyan-100 underline underline-offset-4" target="_blank" rel="noreferrer">Visit Exafuse</a>
      </div>
      <a href="/about" class="btn btn-secondary mt-8">View responsibilities and background</a>
    </div>
  </section>
  <section class="site-shell section-y public-work-index__established">
    <div class="public-work-index__established-grid grid gap-10 lg:grid-cols-[0.85fr_1.15fr]">
      <SectionHeading
        eyebrow="Established work"
        title="Current professional context: LMD/DED"
        description="Deep DED/LMD experience shows how I connect physical processes, sensing, automation and manufacturing systems. Applied AI and modelling support the engineering work, alongside practical process development and measurement."
      />
      <div class="grid gap-4 md:grid-cols-2">
        {establishedWork.map(([heading, text]) => (
          <article class="ordered-card-strong public-work-index__work-card p-5">
            <p class="metric-label">Established work</p>
            <h3 class="mt-3 text-xl font-black text-white">{heading}</h3>
            <p class="mt-3 text-sm leading-6 text-slate-300">{text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="band section-y public-work-index__proof">
    <div class="site-shell">
      <SectionHeading
        eyebrow="Documented examples"
        title="Company-owned cases used as source-bound industrial context"
        description="Each story keeps the industrial problem, public source and scope together. The Duisburg page also includes my personal account of monitoring, control and delivery scheduling. Company project results remain attributed to Exafuse."
      />
      <div class="public-work-index__case-grid public-work-index__case-grid--proof-led mt-10">
        {EXAFUSE_PUBLIC_PROOF.map((item, index) => {
          const pattern = proofDecisionPatterns[item.id];
          return (
          <article class:list={["public-work-index__case-card public-work-index__case-card--proof", index === 0 && "public-work-index__case-card--lead"]}>
            <div class="public-work-index__case-overview">
              <div class="public-work-index__case-summary">
                <p class="metric-label">Exafuse public case</p>
                <h3 class="mt-3 text-2xl font-black text-white">{item.title}</h3>
                <p class="public-work-index__case-context">{item.industrialContext}</p>
                {item.publicMetrics.length > 0 && (
                  <div class="mt-5 flex flex-wrap gap-2">
                    {item.publicMetrics.slice(0, 3).map((metric) => (
                      <span class="chip chip--steel" title={metric.limitation} data-exafuse-proof-metric={metric.sourcePath}>{metric.value}{metric.unit ? ` ${metric.unit}` : ""} · {metric.label}</span>
                    ))}
                  </div>
                )}
              </div>
              <ExafuseProofMedia proof={item} sizes="(max-width: 767px) calc(100vw - 2rem), 38vw" />
            </div>
            <div class="public-work-index__case-reading">
              <p class="public-work-index__case-summary-lesson">{item.mainDecisionLesson}</p>
              <div class="public-work-index__case-evidence">
                <div class="public-work-index__case-lesson">
                  <p class="metric-label">Useful decision pattern</p>
                  <p>{proofDecisionPatternText[item.id]}</p>
                </div>
                <p class="public-work-index__case-limit">{item.whatItDoesNotProve[0]}</p>
                <div class="public-work-index__case-actions mt-6 flex flex-wrap gap-3">
                  <a href={`/public-work/exafuse/${item.slug}`} class="btn btn-primary">Read the proof story</a>
                  <a href={pattern.href} class="btn btn-secondary">{pattern.label}</a>
                </div>
              </div>
            </div>
          </article>
        )})}
      </div>
    </div>
  </section>
  </div>

  <div class="public-work-chapter public-work-chapter--supporting" data-page-chapter="supporting-evidence">
  <section class="site-shell section-y public-work-index__collections">
    <div class="grid gap-10">
      {sections.map((section) => (
        <section class="public-work-index__collection border-t border-white/10 pt-8 first:border-t-0 first:pt-0">
          <div class="grid gap-6 lg:grid-cols-[0.28fr_0.72fr]">
            <div>
              <p class="metric-label">{section.status}</p>
              <h2 class="mt-3 text-2xl font-black text-white">{section.title}</h2>
            </div>
            <SourceLinks links={section.links} />
          </div>
        </section>
      ))}
    </div>
  </section>
  </div>

  <div class="public-work-chapter public-work-chapter--reference" data-page-chapter="reference">
  <section class="site-shell section-y public-work-index__sources">
    <div class="public-work-index__source-sequence">
      <div class="public-work-index__source-group public-work-index__source-group--profiles">
        <SectionHeading eyebrow="Public profile links" title="Profiles and repositories" />
        <div>
          <SourceLinks links={PROFILE_LINKS} />
        </div>
      </div>
      <details class="public-work-index__source-group public-work-index__source-group--industrial public-work-index__source-group--collapsible">
        <summary><SectionHeading eyebrow="Public Exafuse context" title="Public industrial context" /></summary>
        <div class="public-work-index__source-links">
          <SourceLinks links={EXAFUSE_SOURCE_LINKS} />
        </div>
      </details>
    </div>
  </section>
  </div>
  </div>
</Layout>
